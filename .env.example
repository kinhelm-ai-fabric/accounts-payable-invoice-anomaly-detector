# Accounts Payable Invoice Anomaly Detector -- Environment Configuration
# Copy this file to .env and fill in the values.

# ── Flask / Security ──────────────────────────────────────
SECRET_KEY=
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false

# ── Database ──────────────────────────────────────────────
DATA_DIR=/app/data

# ── Server ────────────────────────────────────────────────
PORT=5000
WEB_CONCURRENCY=2
LOG_LEVEL=info

# ── Kindo AI Agent ────────────────────────────────────────
# Invoice Anomaly Detection Agent
# See agent/agents/invoice-anomaly-detector.yaml for agent configuration
KINDO_API_KEY=
KINDO_INVOICE_ANOMALY_AGENT_ID=
